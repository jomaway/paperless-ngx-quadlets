# Map userids to have access to consume and export folders
USERMAP_UID=1000
USERMAP_GID=1000

# Use localhost as they run inside the same podman network
PAPERLESS_REDIS=redis://localhost:6379
PAPERLESS_DBHOST=localhost

# Default filename format, see paperless docs for all options
PAPERLESS_FILENAME_FORMAT={{ document_type }}/{{ created_year }}/{{ correspondent | slugify }}/{{ title | slugify }}

# Enable this if you expose to a custom url
#PAPERLESS_URL=https://paperless.example.com

# Default time and language settings
PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu
