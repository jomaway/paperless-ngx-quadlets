[Unit]
Description=Paperless-ngx postgres database container

[Container]
# Base options
Image=docker.io/library/postgres:18
Pod=paperless.pod

# Storage options
Volume=paperless-pgdata:/var/lib/postgressql

# Environment options
Environment=POSTGRES_DB=paperless POSTGRES_USER=paperless

# Secret options
Secret=paperless-db-password,type=env,target=POSTGRES_PASSWORD

[Service]
Restart=always

[Install]
WantedBy=default.target
